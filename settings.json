{
  "permissions": {
    "deny": [
      "mcp__github-readonly__delete_issue",
      "mcp__github-readonly__merge_pull_request",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./*.lock)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Write(./.git/**)",
      "WebFetch"
    ],
    "ask": [
      "Bash(*)",
      "Write(**)",
      "mcp__github-readonly__create_comment"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "mcp-apps@claude-plugins-official": true,
    "academy-guide@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/preToolUse-bash-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/postToolUse-audit.sh"
          }
        ]
      }
    ],
    "outputStyle": "Concise",
    "effortLevel": "high",
    "autoUpdatesChannel": "latest",
    "theme": "dark-daltonized",
    "cleanupPeriodDays": 14
  }
}
